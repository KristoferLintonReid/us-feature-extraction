# Credentials never belong in the repo.
*.key
secrets/
build/

# Model weights are baked in at image build time, not versioned.
weights/
*.pth
*.safetensors
*.bin

# Run outputs. Scoped to the conventional output locations rather than a blanket
# rule, so the committed example run under examples/ survives.
/out/
/output/
/logs/

# Feature matrices are derived data and large (~33 MB for a five-image run).
# examples/preview/ carries the shapes and real excerpts instead.
examples/output/features/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.DS_Store
